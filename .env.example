# Copy this template to the ignored .env file and add local credentials there.
OPENAI_API_KEY=
DEEPAGENTS_LAB_MODEL=openai:gpt-5.4

# Keep the local workbench detached from LangSmith tracing by default.
LANGSMITH_TRACING=false
